    /** Helper URLConnection that stores written bytes in a ByteArrayOutputStream. */
    private static class TestURLConnection extends URLConnection
    {
        private final ByteArrayOutputStream out = new ByteArrayOutputStream();
        private final ByteArrayInputStream  in;
        private final String contentEncoding;

        protected TestURLConnection(ByteArrayInputStream in, String contentEncoding)
        {
            super(null);
            this.in = in;
            this.contentEncoding = contentEncoding;
        }

        @Override
        public void connect() { /* no real connection */ }

        @Override
        public InputStream getInputStream()
        {
            return in;
        }

        @Override
        public OutputStream getOutputStream()
        {
            return out;
        }

        @Override
        public String getContentEncoding()
        {
            return contentEncoding;
        }

        public byte[] getWrittenBytes()
        {
            return out.toByteArray();
        }
    }

    /** Simple TransferCallback implementation that records the number of bytes transferred. */
    private static class RecordingCallback implements IOUtilities.TransferCallback
    {
        private int total = 0;
        private boolean cancel = false;

        @Override
        public void bytesTransferred(byte[] bytes, int count)
        {
            total += count;
        }

        @Override
        public boolean isCancelled()
        {
            return cancel;
        }

        public int getTotal()
        {
            return total;
        }

        public void setCancelled(boolean cancelled)
        {
            this.cancel = cancelled;
        }
    }

    @Test
    public void testGetInputStream_NoEncoding() throws Exception
    {
        byte[] data = "plain data".getBytes("UTF-8");
        TestURLConnection conn = new TestURLConnection(new ByteArrayInputStream(data), null);
        InputStream is = IOUtilities.getInputStream(conn);
        byte[] read = IOUtilities.inputStreamToBytes(is);
        assertArrayEquals(data, read);
    }

    @Test
    public void testGetInputStream_GzipEncoding() throws Exception
    {
        // Prepare gzipped payload
        ByteArrayOutputStream gzipped = new ByteArrayOutputStream();
        try (DeflaterOutputStream dos = new AdjustableGZIPOutputStream(gzipped, Deflater.BEST_SPEED))
        {
            dos.write("gzipped data".getBytes("UTF-8"));
        }
        byte[] gzippedBytes = gzipped.toByteArray();

        TestURLConnection conn = new TestURLConnection(new ByteArrayInputStream(gzippedBytes), "gzip");
        InputStream is = IOUtilities.getInputStream(conn);
        // The returned stream should already be a GZIPInputStream wrapped in BufferedInputStream
        byte[] read = IOUtilities.inputStreamToBytes(is);
        assertArrayEquals("gzipped data".getBytes("UTF-8"), read);
    }

    @Test
    public void testGetInputStream_DeflateEncoding() throws Exception
    {
        // Create deflated data
        ByteArrayOutputStream deflated = new ByteArrayOutputStream();
        DeflaterOutputStream dos = new DeflaterOutputStream(deflated);
        dos.write("deflated data".getBytes("UTF-8"));
        dos.close();
        byte[] deflatedBytes = deflated.toByteArray();

        TestURLConnection conn = new TestURLConnection(new ByteArrayInputStream(deflatedBytes), "deflate");
        InputStream is = IOUtilities.getInputStream(conn);
        // The stream should be an InflaterInputStream wrapped in a BufferedInputStream
        byte[] read = IOUtilities.inputStreamToBytes(is);
        assertArrayEquals("deflated data".getBytes("UTF-8"), read);
    }

    @Test
    public void testTransfer_File_To_URLConnection() throws Exception
    {
        TestURLConnection conn = new TestURLConnection(null, null);
        RecordingCallback cb = new RecordingCallback();

        IOUtilities.transfer(tempFile, conn, cb);

        byte[] expected = IOUtilities.inputStreamToBytes(new FileInputStream(tempFile));
        assertArrayEquals(expected, conn.getWrittenBytes());
        assertEquals(expected.length, cb.getTotal());
    }

    @Test
    public void testTransfer_URLConnection_To_File() throws Exception
    {
        byte[] payload = "payload from URL".getBytes("UTF-8");
        TestURLConnection conn = new TestURLConnection(new ByteArrayInputStream(payload), null);
        RecordingCallback cb = new RecordingCallback();

        File outFile = File.createTempFile("IOUtilitiesTestOut", ".tmp");
        outFile.deleteOnExit();

        IOUtilities.transfer(conn, outFile, cb);

        byte[] read = IOUtilities.inputStreamToBytes(new FileInputStream(outFile));
        assertArrayEquals(payload, read);
        assertEquals(payload.length, cb.getTotal());
    }

    @Test
    public void testTransfer_InputStream_To_File() throws Exception
    {
        byte[] payload = "stream to file".getBytes("UTF-8");
        RecordingCallback cb = new RecordingCallback();

        File outFile = File.createTempFile("IOUtilitiesTestStream", ".tmp");
        outFile.deleteOnExit();

        try (InputStream in = new ByteArrayInputStream(payload))
        {
            IOUtilities.transfer(in, outFile, cb);
        }

        byte[] read = IOUtilities.inputStreamToBytes(new FileInputStream(outFile));
        assertArrayEquals(payload, read);
        assertEquals(payload.length, cb.getTotal());
    }

    @Test
    public void testTransfer_InputStream_To_OutputStream_WithCallback() throws Exception
