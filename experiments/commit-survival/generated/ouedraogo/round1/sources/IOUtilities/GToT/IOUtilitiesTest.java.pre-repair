    @Test
    public void testCompressBytes_EmptyArray()
    {
        byte[] empty = new byte[0];
        byte[] compressed = IOUtilities.compressBytes(empty);
        // Compressing an empty array still yields a valid GZIP header (non‑null, length > 0)
        assertNotNull(compressed);
        assertTrue(compressed.length > 0);
        // Uncompress should give back the empty array
        assertArrayEquals(empty, IOUtilities.uncompressBytes(compressed));
    }

    @Test(expected = RuntimeException.class)
    public void testCompressBytes_ThrowsRuntimeExceptionOnError()
    {
        // Force an error by passing a null array – the method does not guard against null,
        // so a NullPointerException will be wrapped in RuntimeException.
        IOUtilities.compressBytes(null);
    }

    @Test(expected = RuntimeException.class)
    public void testUncompressBytes_ThrowsRuntimeExceptionOnCorruptData()
    {
        // Random non‑gzipped data that looks like a GZIP header will cause the internal
        // GZIPInputStream to throw; the wrapper converts it to RuntimeException.
        byte[] bogus = new byte[] { (byte)0x1f, (byte)0x8b, 0, 0, 0, 0, 0, 0, 0, 0 };
        IOUtilities.uncompressBytes(bogus);
    }
}
