import static org.junit.Assert.*;

/**
 * Comprehensive JUnit‑4 test suite for {@link IOUtilities}.
 *
 * The suite follows the “three‑expert” workflow described in the prompt:
 *   1. List all public methods.
 *   2. Provide a basic test for each method.
 *   3. Identify edge‑cases / exception scenarios.
 *   4. Add dedicated tests for those edge cases.
 *   5. Merge everything into a single test class.
 *
 * All tests use only the classes, constructors and methods that appear in the
 * supplied source code (or the minimal stubs given for {@code FastByteArrayOutputStream}
 * and {@code TransferCallback}). No external mocking frameworks are used.
 */
public class IOUtilitiesTest
{
    /** Temporary files used by several tests – created in {@link #setUp()} and deleted in {@link #tearDown()}. */
    private File tempFile;
    private File emptyFile;

    @Before
    public void setUp() throws IOException
    {
        tempFile   = File.createTempFile("IOUtilitiesTest", ".tmp");
        emptyFile  = File.createTempFile("IOUtilitiesTestEmpty", ".tmp");
        // Write known data to tempFile
        try (FileOutputStream fos = new FileOutputStream(tempFile))
        {
            fos.write("The quick brown fox jumps over the lazy dog".getBytes("UTF-8"));
        }
        // emptyFile stays empty
    }

    @After
    public void tearDown()
    {
        if (tempFile != null && tempFile.exists())
        {
            tempFile.delete();
        }
        if (emptyFile != null && emptyFile.exists())
        {
            emptyFile.delete();
        }
    }

