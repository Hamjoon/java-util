    @Test
    public void testTransfer_InputStream_To_ByteArray_Success() throws Exception
    {
        byte[] payload = "exact length".getBytes("UTF-8");
        byte[] buffer = new byte[payload.length];
        try (InputStream in = new ByteArrayInputStream(payload))
        {
            IOUtilities.transfer(in, buffer);
        }
        assertArrayEquals(payload, buffer);
