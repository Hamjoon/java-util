    @Test(expected = IOException.class)
    public void testTransfer_InputStream_To_ByteArray_InsufficientData() throws Exception
    {
        byte[] payload = "short".getBytes("UTF-8");
        byte[] buffer = new byte[payload.length + 5]; // larger than source
        try (InputStream in = new ByteArrayInputStream(payload))
        {
            IOUtilities.transfer(in, buffer); // should throw IOException
        }
    }

