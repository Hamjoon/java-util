    @Test
    public void testClose_NullAndNonNull_Closeable() throws Exception
    {
        // Null should be ignored, no exception
        IOUtilities.close((Closeable) null);

        // Non‑null Closeable that throws – we create a wrapper that throws on close
        Closeable bad = new Closeable()
        {
            @Override
            public void close() throws IOException
            {
                throw new IOException("forced");
            }
        };
        // The method must swallow the exception
        IOUtilities.close(bad);
    }

    @Test
    public void testFlush_NullAndNonNull_Flushable() throws Exception
    {
        // Null – nothing happens
        IOUtilities.flush((Flushable) null);

        // Non‑null Flushable that throws
        Flushable bad = new Flushable()
        {
            @Override
            public void flush() throws IOException
            {
                throw new IOException("forced flush");
            }
        };
        IOUtilities.flush(bad); // should swallow
    }

    @Test
    public void testInputStreamToBytes_Normal() throws Exception
    {
        byte[] payload = "stream to bytes".getBytes("UTF-8");
        byte[] result = IOUtilities.inputStreamToBytes(new ByteArrayInputStream(payload));
        assertArrayEquals(payload, result);
    }

    @Test
    public void testInputStreamToBytes_OnErrorReturnsNull() throws Exception
    {
        InputStream errorStream = new InputStream()
        {
            @Override
            public int read() throws IOException
            {
                throw new IOException("forced read error");
            }
        };
        assertNull(IOUtilities.inputStreamToBytes(errorStream));
    }

    @Test
    public void testTransfer_URLConnection_WithByteArray() throws Exception
    {
        byte[] payload = "urlconnection bytes".getBytes("UTF-8");
        TestURLConnection conn = new TestURLConnection(null, null);
        IOUtilities.transfer(conn, payload);
        assertArrayEquals(payload, conn.getWrittenBytes());
    }

    @Test
    public void testCompressAndUncompress_RoundTrip() throws Exception
    {
        byte[] original = new byte[1024];
        for (int i = 0; i < original.length; i++) original[i] = (byte) (i % 256);

        byte[] compressed = IOUtilities.compressBytes(original);
        assertTrue("Compressed data should be smaller than original", compressed.length < original.length);

        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals(original, uncompressed);
    }

    @Test
    public void testCompressBytes_OffsetAndLength() throws Exception
    {
        byte[] source = "0123456789ABCDEF".getBytes("UTF-8");
        // compress only the middle 8 bytes ("456789AB")
        byte[] compressed = IOUtilities.compressBytes(source, 4, 8);
        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals("456789AB".getBytes("UTF-8"), uncompressed);
    }

    @Test
    public void testUncompressBytes_NonGzippedReturnsInput() throws Exception
    {
        byte[] data = "plain not gzipped".getBytes("UTF-8");
        assertSame(data, IOUtilities.uncompressBytes(data));
    }

    @Test
    public void testTransfer_CallbackCancellation() throws Exception
    {
        // Data larger than buffer to ensure multiple iterations
        byte[] payload = new byte[IOUtilities.TRANSFER_BUFFER * 2];
        Arrays.fill(payload, (byte) 'x');

        RecordingCallback cb = new RecordingCallback()
        {
            @Override
            public boolean isCancelled()
            {
                // Cancel after first chunk
                return getTotal() >= IOUtilities.TRANSFER_BUFFER;
            }
        };

        ByteArrayOutputStream out = new ByteArrayOutputStream();
        try (InputStream in = new ByteArrayInputStream(payload))
        {
            IOUtilities.transfer(in, out, cb);
        }

        // Only one buffer worth of data should have been written
        assertEquals(IOUtilities.TRANSFER_BUFFER, out.size());
        assertEquals(IOUtilities.TRANSFER_BUFFER, cb.getTotal());
    }

