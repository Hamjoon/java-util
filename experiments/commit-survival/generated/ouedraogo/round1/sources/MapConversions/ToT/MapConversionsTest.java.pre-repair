package com.cedarsoftware.util.convert;

import org.junit.Before;
import org.junit.Test;

import java.net.URI;
import java.net.URL;
import java.sql.Timestamp;
import java.time.*;
import java.util.*;

import static org.junit.Assert.*;

/**
 * Comprehensive JUnit‑4 tests for {@link MapConversions}.
 *
 * <p>The tests cover the three phases described in the prompt:
 * <ol>
 *   <li>Typical successful conversions using the primary key(s) defined for each method.</li>
 *   <li>Alternative successful conversions using the {@code "_v"} (or {@code "value"}) fallback key.</li>
 *   <li>Failure scenarios that trigger the detailed {@code IllegalArgumentException} generated by {@code fromMap}.</li>
 * </ol>
 *
 * <p>All tests use the real {@link Converter} implementation together with a freshly created
 * {@link ConverterOptions} instance (the library provides a public no‑arg constructor for this
 * class).  No mocking frameworks or custom subclasses are used – only the public API
 * presented in the prompt.</p>
 */
public class MapConversionsTest {

    private Converter converter;

    @Before
    public void setUp() {
        // ConverterOptions has a public no‑arg constructor in the original library.
        ConverterOptions options = new ConverterOptions();
        this.converter = new Converter(options);
    }

    /* ----------------------------------------------------------------------
     * Helper utilities used by many tests
     * ---------------------------------------------------------------------- */
    private static Map<String, Object> map(Object... keyValues) {
        Map<String, Object> m = new HashMap<>();
        for (int i = 0; i < keyValues.length; i += 2) {
            m.put(String.valueOf(keyValues[i]), keyValues[i + 1]);
        }
        return m;
    }

    /* ----------------------------------------------------------------------
     * 1. UUID conversion
     * ---------------------------------------------------------------------- */
    @Test
    public void testToUUID_directKey() {
        UUID expected = UUID.randomUUID();
        Map<String, Object> m = map(MapConversions.UUID, expected);
        Object result = MapConversions.toUUID(m, converter);
        assertEquals(expected, result);
    }

    @Test
    public void testToUUID_mostAndLeastSigBits() {
        long most = 0x1234567890ABCDEFL;
        long least = 0x0FEDCBA098765432L;
        UUID expected = new UUID(most, least);
        Map<String, Object> m = map(MapConversions.MOST_SIG_BITS, most,
                                   MapConversions.LEAST_SIG_BITS, least);
        Object result = MapConversions.toUUID(m, converter);
        assertEquals(expected, result);
    }

    @Test
    public void testToUUID_fallbackValueKey() {
        UUID expected = UUID.randomUUID();
        Map<String, Object> m = map(MapConversions.V, expected); // "_v" fallback
        Object result = MapConversions.toUUID(m, converter);
        assertEquals(expected, result);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToUUID_missingAllKeys() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toUUID(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 2. Primitive wrappers (Byte, Short, Integer, Long, Float, Double, Boolean)
     * ---------------------------------------------------------------------- */
    @Test
    public void testToInt_primaryKey() {
        Map<String, Object> m = map("value", 42); // "value" is accepted by fromMap
        Integer result = MapConversions.toInt(m, converter);
        assertEquals(Integer.valueOf(42), result);
    }

    @Test
    public void testToBoolean_fallbackV() {
        Map<String, Object> m = map(MapConversions.V, true);
        Boolean result = MapConversions.toBoolean(m, converter);
        assertTrue(result);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToDouble_missingKey() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toDouble(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 3. BigDecimal / BigInteger
     * ---------------------------------------------------------------------- */
    @Test
    public void testToBigDecimal_direct() {
        java.math.BigDecimal expected = new java.math.BigDecimal("12345.6789");
        Map<String, Object> m = map(MapConversions.V, expected);
        java.math.BigDecimal result = MapConversions.toBigDecimal(m, converter);
        assertEquals(expected, result);
    }

    @Test
    public void testToBigInteger_direct() {
        java.math.BigInteger expected = new java.math.BigInteger("9876543210");
        Map<String, Object> m = map(MapConversions.VALUE, expected);
        java.math.BigInteger result = MapConversions.toBigInteger(m, converter);
        assertEquals(expected, result);
    }

    /* ----------------------------------------------------------------------
     * 4. String / StringBuilder / StringBuffer / Character
     * ---------------------------------------------------------------------- */
    @Test
    public void testToStringBuilder() {
        StringBuilder sb = new StringBuilder("hello");
        Map<String, Object> m = map(MapConversions.VALUE, sb);
        StringBuilder result = MapConversions.toStringBuilder(m, converter);
        assertSame(sb, result);
    }

    @Test
    public void testToCharacter_fromChar() {
        Character ch = 'Z';
        Map<String, Object> m = map(MapConversions.V, ch);
        Character result = MapConversions.toCharacter(m, converter);
        assertEquals(ch, result);
    }

    /* ----------------------------------------------------------------------
     * 5. Atomic types
     * ---------------------------------------------------------------------- */
    @Test
    public void testToAtomicInteger() {
        AtomicInteger ai = new AtomicInteger(7);
        Map<String, Object> m = map(MapConversions.VALUE, ai);
        AtomicInteger result = MapConversions.toAtomicInteger(m, converter);
        assertSame(ai, result);
    }

    @Test
    public void testToAtomicBoolean_fallbackValue() {
        AtomicBoolean ab = new AtomicBoolean(true);
        Map<String, Object> m = map(MapConversions.VALUE, ab);
        AtomicBoolean result = MapConversions.toAtomicBoolean(m, converter);
        assertSame(ab, result);
    }

    /* ----------------------------------------------------------------------
     * 6. java.util.Date / java.sql.Date via epochMillis handling
     * ---------------------------------------------------------------------- */
    @Test
    public void testToDate_fromEpochMillis() {
        long epoch = 1_600_000_000_123L; // includes milliseconds
        Map<String, Object> m = map(MapConversions.EPOCH_MILLIS, epoch);
        Date result = MapConversions.toDate(m, converter);
        assertEquals(new Date(epoch), result);
    }

    @Test
    public void testToSqlDate_fromEpochMillisAndNanos() {
        long epoch = 1_600_000_000_000L; // seconds part, no millis
        int nanos = 456_000_000; // 456 ms
        Map<String, Object> m = map(MapConversions.EPOCH_MILLIS, epoch,
                                   MapConversions.NANOS, nanos);
        java.sql.Date result = MapConversions.toSqlDate(m, converter);
        // java.sql.Date stores only the date part; the time component is ignored.
        // The constructor receives epoch + nanos/1_000_000 = epoch + 456 ms.
        assertEquals(new java.sql.Date(epoch + 456), result);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToDate_missingAllKeys() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toDate(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 7. Timestamp – both epochMillis path and composite date/time/zone path
     * ---------------------------------------------------------------------- */
    @Test
    public void testToTimestamp_epochMillisWithNanos() {
        long epoch = 1_600_000_000_000L;
        int nanos = 123_456_789;
        Map<String, Object> m = map(MapConversions.EPOCH_MILLIS, epoch,
                                   MapConversions.NANOS, nanos);
        Timestamp ts = MapConversions.toTimestamp(m, converter);
        assertEquals(epoch, ts.getTime());
        assertEquals(nanos, ts.getNanos());
    }

    @Test
    public void testToTimestamp_fromDateTimeComponents() {
        // Build a map with date, time and zone – the method will delegate to toEpochMillis.
        Map<String, Object> m = map(
                MapConversions.DATE, LocalDate.of(2022, 3, 15),
                MapConversions.TIME, LocalTime.of(12, 30, 45, 123_000_000),
                MapConversions.ZONE, ZoneId.of("UTC"));
        Timestamp ts = MapConversions.toTimestamp(m, converter);
        ZonedDateTime zdt = ZonedDateTime.of(LocalDate.of(2022, 3, 15),
                                             LocalTime.of(12, 30, 45, 123_000_000),
                                             ZoneOffset.UTC);
        assertEquals(zdt.toInstant().toEpochMilli(), ts.getTime());
        assertEquals(123_000_000, ts.getNanos());
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToTimestamp_missingAll() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toTimestamp(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 8. TimeZone
     * ---------------------------------------------------------------------- */
    @Test
    public void testToTimeZone() {
        TimeZone tz = TimeZone.getTimeZone("America/New_York");
        Map<String, Object> m = map(MapConversions.ZONE, tz.getID());
        TimeZone result = MapConversions.toTimeZone(m, converter);
        assertEquals(tz.getID(), result.getID());
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToTimeZone_missingKey() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toTimeZone(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 9. Calendar – several branches
     * ---------------------------------------------------------------------- */
    @Test
    public void testToCalendar_fromEpochMillis() {
        long epoch = 1_600_000_000_000L;
        Map<String, Object> m = map(MapConversions.EPOCH_MILLIS, epoch);
        Calendar cal = MapConversions.toCalendar(m, converter);
        assertEquals(epoch, cal.getTimeInMillis());
    }

    @Test
    public void testToCalendar_dateTimeZone() {
        Map<String, Object> m = map(
                MapConversions.DATE, LocalDate.of(2020, 5, 20),
                MapConversions.TIME, LocalTime.of(14, 45, 30, 250_000_000),
                MapConversions.ZONE, ZoneId.of("Europe/Paris"));
        Calendar cal = MapConversions.toCalendar(m, converter);
        ZonedDateTime zdt = ZonedDateTime.of(LocalDate.of(2020, 5, 20),
                LocalTime.of(14, 45, 30, 250_000_000),
                ZoneId.of("Europe/Paris"));
        assertEquals(zdt.toInstant().toEpochMilli(), cal.getTimeInMillis());
    }

    @Test
    public void testToCalendar_timeOnly() {
        // The library parses a time‑only string using DateUtilities.parseDate.
        String timeStr = "15:20:10";
        Map<String, Object> m = map(MapConversions.TIME, timeStr);
        Calendar cal = MapConversions.toCalendar(m, converter);
        // The default zone from ConverterOptions is used; we accept any non‑null result.
        assertNotNull(cal);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToCalendar_missingAll() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toCalendar(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 10. Locale
     * ---------------------------------------------------------------------- */
    @Test
    public void testToLocale_fullSpecification() {
        Map<String, String> m = new HashMap<>();
        m.put(MapConversions.LANGUAGE, "en");
        m.put(MapConversions.COUNTRY, "US");
        m.put(MapConversions.SCRIPT, "Latn");
        m.put(MapConversions.VARIANT, "POSIX");
        Locale result = MapConversions.toLocale(m, converter);
        assertEquals("en", result.getLanguage());
        assertEquals("US", result.getCountry());
        assertEquals("Latn", result.getScript());
        assertEquals("POSIX", result.getVariant());
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToLocale_missingLanguage() {
        Map<String, String> m = new HashMap<>();
        // No language entry – should fall back to fromMap and then throw.
        MapConversions.toLocale(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 11. LocalDate and LocalTime
     * ---------------------------------------------------------------------- */
    @Test
    public void testToLocalDate_fromComponents() {
        Map<String, Object> m = map(
                MapConversions.YEAR, 2021,
                MapConversions.MONTH, 12,
                MapConversions.DAY, 5);
        LocalDate ld = MapConversions.toLocalDate(m, converter);
        assertEquals(LocalDate.of(2021, 12, 5), ld);
    }

    @Test
    public void testToLocalDate_fromDateKey() {
        LocalDate expected = LocalDate.of(1999, 1, 31);
        Map<String, Object> m = map(MapConversions.DATE, expected);
        LocalDate result = MapConversions.toLocalDate(m, converter);
        assertEquals(expected, result);
    }

    @Test
    public void testToLocalTime_fromComponents() {
        Map<String, Object> m = map(
                MapConversions.HOUR, 9,
                MapConversions.MINUTE, 15,
                MapConversions.SECOND, 30,
                MapConversions.NANOS, 555_000_000);
        LocalTime lt = MapConversions.toLocalTime(m, converter);
        assertEquals(LocalTime.of(9, 15, 30, 555_000_000), lt);
    }

    @Test
    public void testToLocalTime_fromTimeKey() {
        LocalTime expected = LocalTime.of(23, 59, 59);
        Map<String, Object> m = map(MapConversions.TIME, expected);
        LocalTime result = MapConversions.toLocalTime(m, converter);
        assertEquals(expected, result);
    }

    /* ----------------------------------------------------------------------
     * 12. OffsetTime
     * ---------------------------------------------------------------------- */
    @Test
    public void testToOffsetTime_withOffsetComponents() {
        Map<String, Object> m = map(
                MapConversions.HOUR, 10,
                MapConversions.MINUTE, 20,
                MapConversions.SECOND, 30,
                MapConversions.NANOS, 0,
                MapConversions.OFFSET_HOUR, -5,
                MapConversions.OFFSET_MINUTE, 0);
        OffsetTime ot = MapConversions.toOffsetTime(m, converter);
        assertEquals(OffsetTime.of(10, 20, 30, 0, ZoneOffset.ofHours(-5)), ot);
    }

    @Test
    public void testToOffsetTime_fromTimeKey() {
        OffsetTime expected = OffsetTime.now();
        Map<String, Object> m = map(MapConversions.TIME, expected);
        OffsetTime result = MapConversions.toOffsetTime(m, converter);
        assertEquals(expected, result);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToOffsetTime_missingAll() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toOffsetTime(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 13. OffsetDateTime
     * ---------------------------------------------------------------------- */
    @Test
    public void testToOffsetDateTime_timeAndOffsetOnly() {
        Map<String, Object> m = map(
                MapConversions.TIME, LocalDateTime.of(2022, 2, 2, 12, 0),
                MapConversions.OFFSET, ZoneOffset.ofHours(2));
        OffsetDateTime odt = MapConversions.toOffsetDateTime(m, converter);
        assertEquals(OffsetDateTime.of(2022, 2, 2, 12, 0, 0, 0, ZoneOffset.ofHours(2)), odt);
    }

    @Test
    public void testToOffsetDateTime_full() {
        Map<String, Object> m = map(
                MapConversions.DATE, LocalDate.of(2022, 2, 2),
                MapConversions.TIME, LocalTime.of(12, 0, 15),
                MapConversions.OFFSET, ZoneOffset.ofHoursMinutes(1, 30));
        OffsetDateTime odt = MapConversions.toOffsetDateTime(m, converter);
        assertEquals(OffsetDateTime.of(2022, 2, 2, 12, 0, 15, 0,
                ZoneOffset.ofHoursMinutes(1, 30)), odt);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToOffsetDateTime_missingAll() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toOffsetDateTime(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 14. ZonedDateTime
     * ---------------------------------------------------------------------- */
    @Test
    public void testToZonedDateTime_fromEpochMillis() {
        long epoch = 1_600_000_000_000L;
        Map<String, Object> m = map(MapConversions.EPOCH_MILLIS, epoch);
        ZonedDateTime zdt = MapConversions.toZonedDateTime(m, converter);
        assertEquals(Instant.ofEpochMilli(epoch), zdt.toInstant());
    }

    @Test
    public void testToZonedDateTime_fullComponents() {
        Map<String, Object> m = map(
                MapConversions.DATE, LocalDate.of(2021, 7, 14),
                MapConversions.TIME, LocalTime.of(9, 45, 0),
                MapConversions.ZONE, ZoneId.of("Europe/London"));
        ZonedDateTime zdt = MapConversions.toZonedDateTime(m, converter);
        assertEquals(ZonedDateTime.of(2021, 7, 14, 9, 45, 0, 0,
                ZoneId.of("Europe/London")), zdt);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToZonedDateTime_missingAll() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toZonedDateTime(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 15. Duration and Instant
     * ---------------------------------------------------------------------- */
    @Test
    public void testToDuration_secondsAndNanos() {
        Map<String, Object> m = map(
                MapConversions.SECONDS, 5L,
                MapConversions.NANOS, 250_000_000);
        Duration d = MapConversions.toDuration(m, converter);
        assertEquals(Duration.ofSeconds(5, 250_000_000), d);
    }

    @Test
    public void testToInstant_secondsOnly() {
        Map<String, Object> m = map(
                MapConversions.SECONDS, 1_600_000_000L);
        Instant instant = MapConversions.toInstant(m, converter);
        assertEquals(Instant.ofEpochSecond(1_600_000_000L), instant);
    }

