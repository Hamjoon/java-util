    /* ----------------------------------------------------------------------
     * 18. URL and URI
     * ---------------------------------------------------------------------- */
    @Test
    public void testToURL_fromString() throws Exception {
        String urlStr = "https://example.com/path?query=1";
        Map<String, Object> m = map(MapConversions.URL_KEY, urlStr);
        URL url = MapConversions.toURL(m, converter);
        assertEquals(new URL(urlStr), url);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToURL_missingKey() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toURL(m, converter);
    }

    @Test
    public void testToURI_fromString() throws Exception {
        String uriStr = "urn:example:test";
        Map<String, Object> m = map(MapConversions.URI_KEY, uriStr);
        URI uri = MapConversions.toURI(m, converter);
        assertEquals(new URI(uriStr), uri);
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToURI_missingKey() {
        Map<String, Object> m = Collections.emptyMap();
        MapConversions.toURI(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 19. Throwable reconstruction
     * ---------------------------------------------------------------------- */
    @Test
    public void testToThrowable_withCause() throws Exception {
        Map<String, Object> m = new HashMap<>();
        m.put(MapConversions.CLASS, IllegalArgumentException.class.getName());
        m.put(MapConversions.MESSAGE, "main exception");
        m.put(MapConversions.CAUSE, NullPointerException.class.getName());
        m.put(MapConversions.CAUSE_MESSAGE, "cause exception");

        Throwable t = MapConversions.toThrowable(m, converter);
        assertTrue(t instanceof IllegalArgumentException);
        assertEquals("main exception", t.getMessage());
        assertNotNull(t.getCause());
        assertTrue(t.getCause() instanceof NullPointerException);
        assertEquals("cause exception", t.getCause().getMessage());
    }

    @Test
    public void testToThrowable_withoutCause() throws Exception {
        Map<String, Object> m = new HashMap<>();
        m.put(MapConversions.CLASS, RuntimeException.class.getName());
        m.put(MapConversions.MESSAGE, "just a message");

        Throwable t = MapConversions.toThrowable(m, converter);
        assertTrue(t instanceof RuntimeException);
        assertEquals("just a message", t.getMessage());
        assertNull(t.getCause());
    }

    @Test(expected = IllegalArgumentException.class)
    public void testToThrowable_invalidClass() {
        Map<String, Object> m = map(MapConversions.CLASS, "non.existent.ClassName");
        MapConversions.toThrowable(m, converter);
    }

    /* ----------------------------------------------------------------------
     * 20. initMap – verifies that the special "_v" key is inserted correctly.
     * ---------------------------------------------------------------------- */
    @Test
    public void testInitMap() {
        String payload = "payload";
        Map<String, ?> result = MapConversions.initMap(payload, converter);
        assertTrue(result.containsKey(MapConversions.V));
        assertEquals(payload, result.get(MapConversions.V));
    }

    /* ----------------------------------------------------------------------
     * 21. fromMap – exercised indirectly by the above tests; a direct
     *              explicit check for the error‑message format.
     * ---------------------------------------------------------------------- */
    @Test
    public void testFromMap_errorMessageStructure() {
        Map<String, Object> empty = Collections.emptyMap();
        try {
            // Force a call that will definitely go through fromMap.
            MapConversions.toClass(empty, converter);
            fail("Expected IllegalArgumentException");
        } catch (IllegalArgumentException e) {
            String msg = e.getMessage();
            assertTrue(msg.contains("To convert from Map to 'Class'"));
            assertTrue(msg.contains("[value]"));
            assertTrue(msg.contains("[_v]"));
        }
    }
}
