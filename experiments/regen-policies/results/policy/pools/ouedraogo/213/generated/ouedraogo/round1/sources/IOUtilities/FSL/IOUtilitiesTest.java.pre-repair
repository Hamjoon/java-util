package com.cedarsoftware.util;

import static org.junit.Assert.*;

import java.io.*;
import java.net.URL;
import java.net.URLConnection;
import java.net.HttpURLConnection;
import java.nio.file.Files;
import java.util.zip.GZIPOutputStream;
import java.util.zip.Deflater;
import java.util.zip.DeflaterOutputStream;

import javax.xml.stream.XMLStreamException;
import javax.xml.stream.XMLStreamReader;
import javax.xml.stream.XMLStreamWriter;

import org.junit.Test;

/**
 * Comprehensive JUnit‑4 test suite for {@link IOUtilities}.
 *
 * The tests exercise every public method, including edge‑cases such as:
 * <ul>
 *   <li>null arguments (expecting {@code NullPointerException})</li>
 *   <li>compressed vs. non‑compressed streams</li>
 *   <li>cancellation of a transfer via {@link IOUtilities.TransferCallback}</li>
 *   <li>exception‑suppressing close/flush helpers</li>
 *   <li>byte‑array compression / decompression round‑trip</li>
 * </ul>
 *
 * Helper classes {@link SimpleURLConnection} and {@link SimpleHttpURLConnection}
 * are lightweight concrete implementations of {@link URLConnection} and
 * {@link HttpURLConnection} used to avoid real network traffic.
 */
public class IOUtilitiesTest {

    /* ---------------------------------------------------------------------- */
    /* Helper concrete URLConnection implementations                           */
    /* ---------------------------------------------------------------------- */

    /** Minimal URLConnection that can return a given InputStream and capture the
     *  OutputStream written to it. */
    private static class SimpleURLConnection extends URLConnection {
        private final ByteArrayInputStream input;
        private final ByteArrayOutputStream output = new ByteArrayOutputStream();
        private String contentEncoding;

        protected SimpleURLConnection(URL url, byte[] data) {
            super(url);
            this.input = new ByteArrayInputStream(data);
        }

        @Override
        public void connect() { /* no real connection needed */ }

        @Override
        public InputStream getInputStream() {
            return input;
        }

        @Override
        public OutputStream getOutputStream() {
            return output;
        }

        @Override
        public String getContentEncoding() {
            return contentEncoding;
        }

        public void setContentEncoding(String enc) {
            this.contentEncoding = enc;
        }

        public byte[] getWrittenBytes() {
            return output.toByteArray();
        }
    }

    /** Minimal HttpURLConnection that records the calls made by {@link IOUtilities#optimizeConnection}. */
    private static class SimpleHttpURLConnection extends HttpURLConnection {
        private final ByteArrayInputStream input;
        private final ByteArrayOutputStream output = new ByteArrayOutputStream();
        private String contentEncoding;
        private boolean followRedirectsSet;
        private boolean useCachesSet;
        private int connectTimeoutSet = -1;
        private int readTimeoutSet = -1;
        private String acceptEncodingHeader;

        protected SimpleHttpURLConnection(URL url, byte[] data) {
            super(url);
            this.input = new ByteArrayInputStream(data);
        }

        @Override
        public void disconnect() {}

        @Override
        public boolean usingProxy() { return false; }

        @Override
        public void connect() {}

        @Override
        public InputStream getInputStream() { return input; }

        @Override
        public OutputStream getOutputStream() { return output; }

        @Override
        public String getContentEncoding() { return contentEncoding; }

        public void setContentEncoding(String enc) { this.contentEncoding = enc; }

        @Override
        public void setInstanceFollowRedirects(boolean follow) {
            this.followRedirectsSet = follow;
        }

        @Override
        public void setUseCaches(boolean usecaches) {
            this.useCachesSet = usecaches;
        }

        @Override
        public void setConnectTimeout(int timeout) {
            this.connectTimeoutSet = timeout;
        }

        @Override
        public void setReadTimeout(int timeout) {
            this.readTimeoutSet = timeout;
        }

        @Override
        public void setRequestProperty(String key, String value) {
            if ("Accept-Encoding".equalsIgnoreCase(key)) {
                this.acceptEncodingHeader = value;
            }
        }

        public boolean isFollowRedirectsSet() { return followRedirectsSet; }
        public boolean isUseCachesSet() { return useCachesSet; }
        public int getConnectTimeoutSet() { return connectTimeoutSet; }
        public int getReadTimeoutSet() { return readTimeoutSet; }
        public String getAcceptEncodingHeader() { return acceptEncodingHeader; }
        public byte[] getWrittenBytes() { return output.toByteArray(); }
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for getInputStream (compression handling)                        */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testGetInputStreamWithoutCompression() throws Exception {
        byte[] data = "plain text".getBytes("UTF-8");
        SimpleURLConnection conn = new SimpleURLConnection(new URL("http://test"), data);
        InputStream is = IOUtilities.getInputStream(conn);
        byte[] read = IOUtilities.inputStreamToBytes(is);
        assertArrayEquals(data, read);
    }

    @Test
    public void testGetInputStreamWithGzipCompression() throws Exception {
        byte[] original = "gzip compressed data".getBytes("UTF-8");
        ByteArrayOutputStream gz = new ByteArrayOutputStream();
        try (GZIPOutputStream gos = new GZIPOutputStream(gz)) {
            gos.write(original);
        }
        SimpleURLConnection conn = new SimpleURLConnection(new URL("http://test"), gz.toByteArray());
        conn.setContentEncoding("gzip");
        InputStream is = IOUtilities.getInputStream(conn);
        byte[] read = IOUtilities.inputStreamToBytes(is);
        assertArrayEquals(original, read);
    }

    @Test
    public void testGetInputStreamWithDeflateCompression() throws Exception {
        byte[] original = "deflate compressed".getBytes("UTF-8");
        ByteArrayOutputStream def = new ByteArrayOutputStream();
        try (DeflaterOutputStream dos = new DeflaterOutputStream(def, new Deflater())) {
            dos.write(original);
        }
        SimpleURLConnection conn = new SimpleURLConnection(new URL("http://test"), def.toByteArray());
        conn.setContentEncoding("deflate");
        InputStream is = IOUtilities.getInputStream(conn);
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        IOUtilities.transfer(is, out);
        assertArrayEquals(original, out.toByteArray());
    }

    @Test(expected = NullPointerException.class)
    public void testGetInputStreamNullArgument() throws Exception {
        IOUtilities.getInputStream(null);
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for optimizeConnection (HttpURLConnection)                       */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testOptimizeConnectionSetsHttpProperties() throws Exception {
        SimpleHttpURLConnection httpConn = new SimpleHttpURLConnection(new URL("http://example.com"), new byte[0]);
        // The method is private; we invoke it indirectly via getInputStream which calls it.
        // Provide empty (non‑compressed) stream.
        InputStream is = IOUtilities.getInputStream(httpConn);
        // Consume stream to force the method to run
        is.close();

        assertTrue(httpConn.isFollowRedirectsSet());
        assertFalse(httpConn.isUseCachesSet());
        assertEquals(5000, httpConn.getConnectTimeoutSet());
        assertEquals(30000, httpConn.getReadTimeoutSet());
        assertEquals("gzip, x-gzip, deflate", httpConn.getAcceptEncodingHeader());
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for transfer(InputStream, OutputStream, TransferCallback)        */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testTransferWithCallbackAndCancellation() throws Exception {
        byte[] data = new byte[100];
        for (int i = 0; i < data.length; i++) data[i] = (byte) i;

        ByteArrayInputStream in = new ByteArrayInputStream(data);
        ByteArrayOutputStream out = new ByteArrayOutputStream();

        final int[] bytesSeen = {0};
        IOUtilities.TransferCallback cb = new IOUtilities.TransferCallback() {
            @Override
            public void bytesTransferred(byte[] bytes, int count) {
                bytesSeen[0] += count;
            }

            @Override
            public boolean isCancelled() {
                // Cancel after 40 bytes have been transferred
                return bytesSeen[0] >= 40;
            }
        };

        IOUtilities.transfer(in, out, cb);
        assertTrue("Transfer should stop before all bytes are written", out.size() < data.length);
        assertEquals(bytesSeen[0], out.size());
    }

    @Test
    public void testTransferWithoutCallbackCopiesAllBytes() throws Exception {
        byte[] data = "full copy".getBytes("UTF-8");
        ByteArrayInputStream in = new ByteArrayInputStream(data);
        ByteArrayOutputStream out = new ByteArrayOutputStream();

        IOUtilities.transfer(in, out, null);
        assertArrayEquals(data, out.toByteArray());
    }

    @Test(expected = NullPointerException.class)
    public void testTransferInputNull() throws Exception {
        IOUtilities.transfer(null, new ByteArrayOutputStream(), null);
    }

    @Test(expected = NullPointerException.class)
    public void testTransferOutputNull() throws Exception {
        IOUtilities.transfer(new ByteArrayInputStream(new byte[0]), null, null);
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for transfer(InputStream, byte[])                                 */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testTransferInputToByteArrayExactly() throws Exception {
        byte[] src = "exact".getBytes("UTF-8");
        ByteArrayInputStream in = new ByteArrayInputStream(src);
        byte[] dest = new byte[src.length];
        IOUtilities.transfer(in, dest);
        assertArrayEquals(src, dest);
    }

    @Test(expected = java.io.EOFException.class)
    public void testTransferInputToByteArrayInsufficientData() throws Exception {
        byte[] src = "short".getBytes("UTF-8");
        ByteArrayInputStream in = new ByteArrayInputStream(src);
        byte[] dest = new byte[src.length + 5]; // larger than source
        IOUtilities.transfer(in, dest); // should throw EOFException
    }

    @Test(expected = NullPointerException.class)
    public void testTransferInputToByteArrayNullInput() throws Exception {
        IOUtilities.transfer(null, new byte[10]);
    }

    @Test(expected = NullPointerException.class)
    public void testTransferInputToByteArrayNullArray() throws Exception {
        IOUtilities.transfer(new ByteArrayInputStream(new byte[0]), null);
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for transfer(File, OutputStream)                                  */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testTransferFileToOutputStream() throws Exception {
        File tmp = Files.createTempFile("ioutil", ".txt").toFile();
        tmp.deleteOnExit();
        byte[] content = "file content".getBytes("UTF-8");
        Files.write(tmp.toPath(), content);

        ByteArrayOutputStream out = new ByteArrayOutputStream();
        IOUtilities.transfer(tmp, out);
        assertArrayEquals(content, out.toByteArray());
    }

    @Test(expected = NullPointerException.class)
    public void testTransferFileToOutputStreamNullFile() throws Exception {
        IOUtilities.transfer(null, new ByteArrayOutputStream());
    }

    @Test(expected = NullPointerException.class)
    public void testTransferFileToOutputStreamNullOut() throws Exception {
        File tmp = Files.createTempFile("ioutil", ".txt").toFile();
        tmp.deleteOnExit();
        IOUtilities.transfer(tmp, null);
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for transfer(URLConnection, byte[])                               */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testTransferBytesToURLConnection() throws Exception {
        byte[] payload = "payload".getBytes("UTF-8");
        SimpleURLConnection conn = new SimpleURLConnection(new URL("http://test"), new byte[0]);
        IOUtilities.transfer(conn, payload);
        assertArrayEquals(payload, conn.getWrittenBytes());
    }

