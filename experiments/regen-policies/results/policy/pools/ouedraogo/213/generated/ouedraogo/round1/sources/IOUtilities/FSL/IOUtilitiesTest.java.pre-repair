        IOUtilities.transfer(conn, null);
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for compressBytes / uncompressBytes (byte[] overloads)            */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testCompressAndUncompressRoundTrip() {
        byte[] original = "compress me!".getBytes();
        byte[] compressed = IOUtilities.compressBytes(original);
        assertNotNull(compressed);
        assertTrue(compressed.length < original.length); // usually smaller

        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals(original, uncompressed);
    }

    @Test
    public void testCompressWithOffsetAndLength() {
        byte[] source = "ABCDEFGH".getBytes();
        // compress only "CDE"
        byte[] compressed = IOUtilities.compressBytes(source, 2, 3);
        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals("CDE".getBytes(), uncompressed);
    }

    @Test(expected = NullPointerException.class)
    public void testCompressBytesNullArray() {
        IOUtilities.compressBytes((byte[]) null);
    }

    @Test(expected = NullPointerException.class)
    public void testUncompressBytesNullArray() {
        IOUtilities.uncompressBytes((byte[]) null);
    }

    /* ---------------------------------------------------------------------- */
    /* Tests for compressBytes(ByteArrayOutputStream, ByteArrayOutputStream)   */
    /* ---------------------------------------------------------------------- */

    @Test
    public void testCompressBytesByteArrayOutputStream() throws Exception {
        ByteArrayOutputStream original = new ByteArrayOutputStream();
        original.write("stream data".getBytes());

        ByteArrayOutputStream compressed = new ByteArrayOutputStream();
        IOUtilities.compressBytes(original, compressed);

        byte[] uncompressed = IOUtilities.uncompressBytes(compressed.toByteArray());
        assertArrayEquals(original.toByteArray(), uncompressed);
    }

    @Test(expected = NullPointerException.class)
    public void testCompressBytesByteArrayOutputStreamNullOriginal() throws Exception {
        IOUtilities.compressBytes(null, new ByteArrayOutputStream());
    }

    @Test(expected = NullPointerException.class)
    public void testCompressBytesByteArrayOutputStreamNullCompressed() throws Exception {
        IOUtilities.compressBytes(new ByteArrayOutputStream(), null);
    }

