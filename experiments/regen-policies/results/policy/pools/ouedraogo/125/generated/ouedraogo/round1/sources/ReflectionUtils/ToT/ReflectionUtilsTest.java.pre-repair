    public void testGetMethodExactMatch() {
        Method m = ReflectionUtils.getMethod(BaseClass.class, "overloaded", int.class);
        assertNotNull(m);
        assertEquals("overloaded", m.getName());
        assertArrayEquals(new Class<?>[]{int.class}, m.getParameterTypes());
