    @Test
    public void testGetMethodReturnsNullWhenMissing() {
        Method m = ReflectionUtils.getMethod(BaseClass.class, "nonExistentMethod");
        assertNull(m);
    }

    @Test
    public void testGetMethodNullArguments() {
        thrown.expect(IllegalArgumentException.class);
