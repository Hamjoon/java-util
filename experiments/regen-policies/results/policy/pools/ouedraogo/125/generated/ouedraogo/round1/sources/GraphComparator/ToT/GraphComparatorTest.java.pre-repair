package com.cedarsoftware.util;

import org.junit.Test;
import org.junit.Before;
import org.junit.Rule;
import org.junit.rules.ExpectedException;

import java.lang.reflect.Field;
import java.math.BigInteger;
import java.util.*;

import static org.junit.Assert.*;

/**
 * Comprehensive JUnit‑4 test suite for {@link GraphComparator}.
 *
 * The tests are grouped by the method they exercise and cover:
 * <ul>
 *   <li>Typical usage of {@link GraphComparator#compare(Object, Object, GraphComparator.ID)}</li>
 *   <li>Edge cases such as null values, empty collections, primitive wrappers, and cyclic graphs</li>
 *   <li>Error scenarios – illegal arguments, illegal command usage, and bad optional keys</li>
 *   <li>Correct behaviour of helper utilities ({@link GraphComparator.Delta},
 *       {@link GraphComparator.Delta.Command}, {@link GraphComparator.DeltaProcessor})</li>
 *   <li>Round‑trip verification – a delta generated by {@code compare} can be applied
 *       to the source object graph using {@link GraphComparator#applyDelta(Object, List, GraphComparator.ID, GraphComparator.DeltaProcessor, boolean...)}
 *       and the source becomes equal to the target.</li>
 * </ul>
 *
 * No external mocking frameworks are used – all objects are real instances created
 * with the public constructors that exist in the source file.
 */
public class GraphComparatorTest {

    /** Simple POJO used for ID‑based graph comparison */
    public static class Person {
        public Long id;
        public String name;
        public int age;
        public Person spouse;                     // reference to another Person (creates cycles)
        public List<String> nicknames = new ArrayList<>();
        public Set<Integer> scores = new HashSet<>();
        public Map<String, String> attributes = new HashMap<>();
        public int[] numbers;                     // primitive array
        public Person[] children;                 // non‑primitive array

        public Person(Long id) { this.id = id; }
    }

    /** ID fetcher that returns the {@code id} field of a {@link Person} */
    private static class PersonIdFetcher implements GraphComparator.ID {
        @Override
        public Object getId(Object objectToId) {
            return ((Person) objectToId).id;
        }
    }

    private PersonIdFetcher idFetcher;

    @Rule
    public ExpectedException thrown = ExpectedException.none();

    @Before
    public void setUp() {
        idFetcher = new PersonIdFetcher();
    }

    /* ----------------------------------------------------------------------
     *  Tests for GraphComparator.Delta – equals, hashCode and toString
     * ---------------------------------------------------------------------- */
    @Test
    public void testDeltaEqualityAndHashCode() {
        GraphComparator.Delta d1 = new GraphComparator.Delta(1L, "field", "ptr", "src", "tgt", null);
        GraphComparator.Delta d2 = new GraphComparator.Delta(2L, "other", "ptr", "src2", "tgt2", null);
        GraphComparator.Delta d3 = new GraphComparator.Delta(3L, "field", "differentPtr", "src", "tgt", null);

        // Equality is based solely on srcPtr
        assertEquals(d1, d2);
        assertNotEquals(d1, d3);
        assertEquals(d1.hashCode(), d2.hashCode());
        assertNotEquals(d1.hashCode(), d3.hashCode());

        // toString contains all fields (basic sanity)
        String s = d1.toString();
        assertTrue(s.contains("id=1"));
        assertTrue(s.contains("fieldName='field'"));
        assertTrue(s.contains("srcValue=src"));
        assertTrue(s.contains("targetValue=tgt"));
    }

    /* ----------------------------------------------------------------------
     *  Tests for Command.fromName – valid and invalid inputs
     * ---------------------------------------------------------------------- */
    @Test
    public void testCommandFromNameValid() {
        for (GraphComparator.Delta.Command cmd : GraphComparator.Delta.Command.values()) {
            assertEquals(cmd, GraphComparator.Delta.Command.fromName(cmd.getName()));
        }
    }

    @Test
    public void testCommandFromNameInvalid() {
        thrown.expect(IllegalArgumentException.class);
        GraphComparator.Delta.Command.fromName("nonexistent");
    }

    @Test
    public void testCommandFromNameNullOrEmpty() {
        thrown.expect(IllegalArgumentException.class);
        GraphComparator.Delta.Command.fromName("   ");
    }

    /* ----------------------------------------------------------------------
     *  Tests for isLogicalPrimitive – a variety of classes
     * ---------------------------------------------------------------------- */
    @Test
    public void testIsLogicalPrimitive() throws Exception {
        // Use reflection to access the private method
        java.lang.reflect.Method m = GraphComparator.class.getDeclaredMethod("isLogicalPrimitive", Class.class);
        m.setAccessible(true);

        assertTrue((Boolean) m.invoke(null, int.class));
        assertTrue((Boolean) m.invoke(null, Integer.class));
        assertTrue((Boolean) m.invoke(null, String.class));
        assertTrue((Boolean) m.invoke(null, Boolean.class));
        assertTrue((Boolean) m.invoke(null, Character.class));
        assertTrue((Boolean) m.invoke(null, Date.class));
        assertTrue((Boolean) m.invoke(null, Calendar.class));
        assertTrue((Boolean) m.invoke(null, TimeZone.class));
        assertFalse((Boolean) m.invoke(null, Person.class));
        assertFalse((Boolean) m.invoke(null, List.class));
    }

    /* ----------------------------------------------------------------------
     *  Tests for isIdObject – objects that can be identified by the ID fetcher
     * ---------------------------------------------------------------------- */
    @Test
    public void testIsIdObject() throws Exception {
        java.lang.reflect.Method m = GraphComparator.class.getDeclaredMethod("isIdObject", Object.class, GraphComparator.ID.class);
        m.setAccessible(true);

        Person p = new Person(10L);
        assertTrue((Boolean) m.invoke(null, p, idFetcher));

        // Primitive wrapper – not an ID object
        assertFalse((Boolean) m.invoke(null, Integer.valueOf(5), idFetcher));

        // Null is never an ID object
        assertFalse((Boolean) m.invoke(null, null, idFetcher));
    }

    /* ----------------------------------------------------------------------
     *  compare() – simple primitive field change
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareSimplePrimitiveChange() {
        Person src = new Person(1L);
        src.name = "Alice";
        src.age = 30;

        Person tgt = new Person(1L);
        tgt.name = "Alice";
        tgt.age = 31;                     // age differs

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        assertEquals(1, deltas.size());
        GraphComparator.Delta d = deltas.get(0);
        assertEquals(GraphComparator.Delta.Command.OBJECT_ASSIGN_FIELD, d.getCmd());
        assertEquals("age", d.getFieldName());
        assertEquals(30, d.getSourceValue());
        assertEquals(31, d.getTargetValue());
    }

    /* ----------------------------------------------------------------------
     *  compare() – array resize and element change (primitive array)
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareArrayResizeAndSetElement() {
        Person src = new Person(2L);
        src.numbers = new int[]{1, 2, 3};

        Person tgt = new Person(2L);
        tgt.numbers = new int[]{1, 9, 3, 4};   // element 1 changed, array length increased

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        // Expect one resize + one element set
        assertEquals(2, deltas.size());

        boolean resizeSeen = false;
        boolean setSeen = false;
        for (GraphComparator.Delta d : deltas) {
            if (d.getCmd() == GraphComparator.Delta.Command.ARRAY_RESIZE) {
                resizeSeen = true;
                assertEquals(4, d.getOptionalKey());
            } else if (d.getCmd() == GraphComparator.Delta.Command.ARRAY_SET_ELEMENT) {
                setSeen = true;
                assertEquals(1, d.getOptionalKey()); // index 1 changed from 2 -> 9
                assertEquals(2, d.getSourceValue());
                assertEquals(9, d.getTargetValue());
            }
        }
        assertTrue(resizeSeen && setSeen);
    }

    /* ----------------------------------------------------------------------
     *  compare() – non‑primitive array (object references)
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareObjectArrayWithIdObjects() {
        Person child1 = new Person(101L);
        child1.name = "Bob";

        Person child2 = new Person(102L);
        child2.name = "Carol";

        Person src = new Person(3L);
        src.children = new Person[]{child1, child2};

        // Target swaps order – IDs are the same but positions differ → set‑element deltas
        Person srcCopy = new Person(3L);
        srcCopy.children = new Person[]{child2, child1};

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, srcCopy, idFetcher);
        // Two set‑element commands (positions 0 and 1)
        assertEquals(2, deltas.size());
        for (GraphComparator.Delta d : deltas) {
            assertEquals(GraphComparator.Delta.Command.ARRAY_SET_ELEMENT, d.getCmd());
            // optionalKey holds the index
            int idx = (Integer) d.getOptionalKey();
            assertTrue(idx == 0 || idx == 1);
        }
    }

    /* ----------------------------------------------------------------------
     *  compare() – Set add / remove
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareSetAddRemove() {
        Person src = new Person(4L);
        src.scores.addAll(Arrays.asList(10, 20, 30));

        Person tgt = new Person(4L);
        tgt.scores.addAll(Arrays.asList(20, 30, 40)); // 10 removed, 40 added

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        assertEquals(2, deltas.size());

        boolean addSeen = false, removeSeen = false;
        for (GraphComparator.Delta d : deltas) {
            if (d.getCmd() == GraphComparator.Delta.Command.SET_ADD) {
                addSeen = true;
                assertEquals(40, d.getTargetValue());
            } else if (d.getCmd() == GraphComparator.Delta.Command.SET_REMOVE) {
                removeSeen = true;
                assertEquals(10, d.getSourceValue());
            }
        }
        assertTrue(addSeen && removeSeen);
    }

    /* ----------------------------------------------------------------------
     *  compare() – Map put / remove
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareMapPutRemove() {
        Person src = new Person(5L);
        src.attributes.put("color", "red");
        src.attributes.put("size", "M");

        Person tgt = new Person(5L);
        tgt.attributes.put("color", "blue"); // changed value
        tgt.attributes.put("weight", "10kg"); // new key

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        // Expect one MAP_PUT (color) and one MAP_REMOVE (size) and one MAP_PUT (weight)
        assertEquals(3, deltas.size());

        boolean putColor = false, putWeight = false, removeSize = false;
        for (GraphComparator.Delta d : deltas) {
            if (d.getCmd() == GraphComparator.Delta.Command.MAP_PUT) {
                if ("color".equals(d.getOptionalKey())) {
                    putColor = true;
                    assertEquals("blue", d.getTargetValue());
                } else if ("weight".equals(d.getOptionalKey())) {
                    putWeight = true;
                    assertEquals("10kg", d.getTargetValue());
                }
            } else if (d.getCmd() == GraphComparator.Delta.Command.MAP_REMOVE) {
                assertEquals("size", d.getOptionalKey());
                removeSize = true;
            }
        }
        assertTrue(putColor && putWeight && removeSize);
    }

    /* ----------------------------------------------------------------------
     *  compare() – List resize and element set
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareListResizeAndSetElement() {
        Person src = new Person(6L);
        src.nicknames.addAll(Arrays.asList("Al", "Lice"));

        Person tgt = new Person(6L);
        tgt.nicknames.addAll(Arrays.asList("Al", "Lice", "A")); // added element at end

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        // One LIST_RESIZE (size 3) and one LIST_SET_ELEMENT for index 2
        assertEquals(2, deltas.size());

        boolean resizeSeen = false, setSeen = false;
        for (GraphComparator.Delta d : deltas) {
            if (d.getCmd() == GraphComparator.Delta.Command.LIST_RESIZE) {
                resizeSeen = true;
                assertEquals(3, d.getOptionalKey());
            } else if (d.getCmd() == GraphComparator.Delta.Command.LIST_SET_ELEMENT) {
                setSeen = true;
                assertEquals(2, d.getOptionalKey());
                assertNull(d.getSourceValue());
                assertEquals("A", d.getTargetValue());
            }
        }
        assertTrue(resizeSeen && setSeen);
    }

    /* ----------------------------------------------------------------------
     *  compare() – orphan detection (object present in source but not in target)
     * ---------------------------------------------------------------------- */
    @Test
    public void testOrphanDetection() {
        Person src = new Person(7L);
        Person extra = new Person(999L);               // not referenced from target
        src.spouse = extra;                            // make it reachable from source

        Person tgt = new Person(7L);
        // target has no spouse → extra becomes orphan

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        // One OBJECT_ORPHAN delta for id 999
        boolean orphanSeen = false;
        for (GraphComparator.Delta d : deltas) {
            if (d.getCmd() == GraphComparator.Delta.Command.OBJECT_ORPHAN) {
                orphanSeen = true;
                assertEquals(999L, d.getId());
            }
        }
        assertTrue(orphanSeen);
    }

    /* ----------------------------------------------------------------------
     *  applyDelta() – successful round‑trip (compare → apply)
     * ---------------------------------------------------------------------- */
    @Test
    public void testApplyDeltaRoundTrip() {
        // Build source graph
        Person src = new Person(10L);
        src.name = "John";
        src.age = 40;
        src.nicknames.addAll(Arrays.asList("J", "Johnny"));
        src.scores.addAll(Arrays.asList(5, 7));
        src.numbers = new int[]{1, 2, 3};

        // Build target graph with several differences
        Person tgt = new Person(10L);
        tgt.name = "Johnathan";                     // name changed
        tgt.age = 41;                               // age changed
        tgt.nicknames.addAll(Arrays.asList("J", "Johnny", "JJ")); // list grew
        tgt.scores.addAll(Arrays.asList(5, 8));    // set changed (7 -> 8)
        tgt.numbers = new int[]{1, 9, 3, 4};        // array resized + element changed

        // Generate delta
        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        // Apply delta to source
        List<GraphComparator.DeltaError> errors = GraphComparator.applyDelta(src, deltas,
                idFetcher, GraphComparator.getJavaDeltaProcessor());

        assertTrue("No errors expected when applying delta", errors.isEmpty());

        // After applying, source should be deep‑equal to target
        assertTrue(DeepEquals.deepEquals(src, tgt));
    }

    /* ----------------------------------------------------------------------
     *  applyDelta() – error when optionalKey is invalid for ARRAY_RESIZE
     * ---------------------------------------------------------------------- */
    @Test
    public void testApplyDeltaInvalidResizeKey() {
        // Prepare a simple object with an int[] field
        class Wrapper {
            public int[] arr = new int[]{1, 2, 3};
        }
        Wrapper src = new Wrapper();
        Wrapper tgt = new Wrapper();

        // Create a delta that tries to resize to a negative length
        GraphComparator.Delta badDelta = new GraphComparator.Delta(0L, "arr", "-root-", src.arr, tgt.arr, -5);
        badDelta.setCmd(GraphComparator.Delta.Command.ARRAY_RESIZE);

        List<GraphComparator.Delta> deltas = Collections.singletonList(badDelta);
        List<GraphComparator.DeltaError> errors = GraphComparator.applyDelta(src, deltas,
                (o) -> 0L, GraphComparator.getJavaDeltaProcessor());

        assertEquals(1, errors.size());
        assertTrue(errors.get(0).getError().contains("failed, the optionalKey must be a integer value 0 or greater"));
    }

    /* ----------------------------------------------------------------------
     *  applyDelta() – error when field does not exist (OBJECT_ASSIGN_FIELD)
     * ---------------------------------------------------------------------- */
    @Test
    public void testApplyDeltaMissingFieldError() {
        Person src = new Person(11L);
        Person tgt = new Person(11L);
        tgt.name = "NewName";

        // Force a delta that refers to a non‑existent field
        GraphComparator.Delta delta = new GraphComparator.Delta(11L, "nonExistent", "-root-", null, "NewName", null);
        delta.setCmd(GraphComparator.Delta.Command.OBJECT_ASSIGN_FIELD);

        List<GraphComparator.DeltaError> errors = GraphComparator.applyDelta(src,
                Collections.singletonList(delta), idFetcher, GraphComparator.getJavaDeltaProcessor());

        assertEquals(1, errors.size());
        assertTrue(errors.get(0).getError().contains("field name missing"));
    }

    /* ----------------------------------------------------------------------
     *  Helper utility – getResizeValue throws for negative index
     * ---------------------------------------------------------------------- */
    @Test
    public void testHelperGetResizeValueNegative() throws Exception {
        java.lang.reflect.Method m = GraphComparator.DeltaProcessor.Helper.class
                .getDeclaredMethod("getResizeValue", GraphComparator.Delta.class);
        m.setAccessible(true);

        GraphComparator.Delta delta = new GraphComparator.Delta(0L, null, "-root-", null, null, -1);
        delta.setCmd(GraphComparator.Delta.Command.ARRAY_SET_ELEMENT);

        thrown.expect(IllegalArgumentException.class);
        m.invoke(null, delta);
    }

    /* ----------------------------------------------------------------------
     *  Helper utility – getStringValue for array formatting
     * ---------------------------------------------------------------------- */
    @Test
    public void testHelperGetStringValueArrayFormatting() throws Exception {
        java.lang.reflect.Method m = GraphComparator.DeltaProcessor.Helper.class
                .getDeclaredMethod("getStringValue", Object.class);
        m.setAccessible(true);

        int[] arr = new int[]{1, 2, 3};
        String result = (String) m.invoke(null, arr);
        assertEquals("[1,2,3]", result);
    }

    /* ----------------------------------------------------------------------
     *  verify that compare() correctly handles null source or target values
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareNullValues() {
        Person src = new Person(12L);
        src.name = null;               // explicit null

        Person tgt = new Person(12L);
        tgt.name = "Bob";

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        assertEquals(1, deltas.size());
        GraphComparator.Delta d = deltas.get(0);
        assertEquals(GraphComparator.Delta.Command.OBJECT_ASSIGN_FIELD, d.getCmd());
        assertNull(d.getSourceValue());
        assertEquals("Bob", d.getTargetValue());
    }

    /* ----------------------------------------------------------------------
     *  compare() – handling of different collection implementations (ArrayList vs LinkedList)
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareDifferentListImplementations() {
        Person src = new Person(13L);
        src.nicknames = new ArrayList<>(Arrays.asList("a", "b"));

        Person tgt = new Person(13L);
        tgt.nicknames = new LinkedList<>(Arrays.asList("a", "c")); // element changed

        List<GraphComparator.Delta> deltas = GraphComparator.compare(src, tgt, idFetcher);
        // Expect resize (same size) is not needed; only one LIST_SET_ELEMENT for index 1
        assertEquals(1, deltas.size());
        GraphComparator.Delta d = deltas.get(0);
        assertEquals(GraphComparator.Delta.Command.LIST_SET_ELEMENT, d.getCmd());
        assertEquals(1, d.getOptionalKey());
        assertEquals("b", d.getSourceValue());
        assertEquals("c", d.getTargetValue());
    }

    /* ----------------------------------------------------------------------
     *  compare() – cyclic graph handling (no infinite loop, visited detection)
     * ---------------------------------------------------------------------- */
    @Test
    public void testCompareCyclicGraph() {
        Person a = new Person(20L);
        Person b = new Person(21L);
        a.spouse = b;
        b.spouse = a; // cycle

        Person a2 = new Person(20L);
        Person b2 = new Person(21L);
        a2.spouse = b2;
        b2.spouse = a2; // identical cycle

        List<GraphComparator.Delta> deltas = GraphComparator.compare(a, a2, idFetcher);
        // No differences, but also no StackOverflowError
        assertTrue(deltas.isEmpty());
    }
}
