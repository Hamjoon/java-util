package com.cedarsoftware.util.convert;

import org.junit.Test;
import org.junit.Before;
import static org.junit.Assert.*;

import java.time.LocalTime;

/**
 * JUnit 4 test suite for {@link LongConversions}.
 *
 * This file was generated by analysing the source code of {@code LongConversions}
 * and creating test cases that cover normal operation as well as identified edge
 * cases and exception scenarios.
 */
public class LongConversionsTest {

    // -----------------------------------------------------------------------
    // 1. Public methods extracted from LongConversions
    // -----------------------------------------------------------------------
    // static LocalTime toLocalTime(Object from, Converter converter)

    private Converter dummyConverter;

    @Before
    public void setUp() {
        // The Converter parameter is not used by the current implementation of
        // LongConversions.toLocalTime, therefore we can safely pass a minimal
        // instance.  The real Converter class requires a ConverterOptions object;
        // we create one using its public constructor.
        dummyConverter = new Converter(new ConverterOptions());
    }

    // -----------------------------------------------------------------------
    // 2. Basic functionality tests
    // -----------------------------------------------------------------------

    /**
     * Verify that a normal millisecond value within the day range is correctly
     * converted to a {@link LocalTime}.
     */
    @Test
    public void testToLocalTime_NormalValue() {
        // 01:23:45.678 = 1 hour, 23 minutes, 45 seconds and 678 ms
        long millis = (1L * 60 * 60 * 1000)      // 1 hour
                    + (23L * 60 * 1000)         // 23 minutes
                    + (45L * 1000)              // 45 seconds
                    + 678L;                     // 678 ms

        LocalTime expected = LocalTime.of(1, 23, 45, 678_000_000); // nanos = ms * 1_000_000
        LocalTime actual = LongConversions.toLocalTime(millis, dummyConverter);
        assertEquals("Converted LocalTime does not match expected value", expected, actual);
    }

    /**
     * Verify conversion of the minimum allowed value (0 ms) which should
     * produce midnight (00:00:00.000).
     */
    @Test
    public void testToLocalTime_ZeroMillis() {
        long millis = 0L;
        LocalTime expected = LocalTime.MIDNIGHT;
        LocalTime actual = LongConversions.toLocalTime(millis, dummyConverter);
        assertEquals("Zero milliseconds should convert to MIDNIGHT", expected, actual);
    }

    /**
     * Verify conversion of the maximum allowed millisecond value.
     * The maximum valid millisecond is 86_399_999 ms (23:59:59.999).
     */
    @Test
    public void testToLocalTime_MaximumMillis() {
        long millis = 86_399_999L; // 23:59:59.999
        LocalTime expected = LocalTime.of(23, 59, 59, 999_000_000);
        LocalTime actual = LongConversions.toLocalTime(millis, dummyConverter);
        assertEquals("Maximum valid milliseconds should convert to 23:59:59.999", expected, actual);
    }

    // -----------------------------------------------------------------------
    // 3. Edge‑case and exception tests
    // -----------------------------------------------------------------------

    /**
     * Negative millisecond values are illegal. The method should throw an
     * {@link IllegalArgumentException} with a message that contains the
     * offending value.
     */
    @Test(expected = IllegalArgumentException.class)
    public void testToLocalTime_NegativeMillis() {
        long negativeMillis = -1L;
        try {
            LongConversions.toLocalTime(negativeMillis, dummyConverter);
        } catch (IllegalArgumentException e) {
            assertTrue("Exception message should contain the negative value",
                       e.getMessage().contains(String.valueOf(negativeMillis)));
            throw e; // re‑throw to satisfy the @Test(expected=…) contract
        }
    }

    /**
     * Values greater than the maximum number of milliseconds in a day (86_399_999)
     * are illegal and must result in an {@link IllegalArgumentException}.
     */
    @Test(expected = IllegalArgumentException.class)
    public void testToLocalTime_TooLargeMillis() {
        long tooLargeMillis = 86_400_000L; // 24:00:00.000 – one millisecond past the day
        try {
            LongConversions.toLocalTime(tooLargeMillis, dummyConverter);
        } catch (IllegalArgumentException e) {
            assertTrue("Exception message should contain the out‑of‑range value",
                       e.getMessage().contains(String.valueOf(tooLargeMillis)));
            throw e;
        }
    }

    /**
     * The method expects the first argument to be a {@link Long} (or a value
     * that can be cast to {@code Long}). Passing an object of a different type
     * will cause a {@code ClassCastException} before the method's own validation
     * runs. This test confirms that behaviour.
     */
    @Test(expected = ClassCastException.class)
    public void testToLocalTime_InvalidObjectType() {
        String notALong = "12345";
        // The implementation casts the argument to Long directly, so a
        // ClassCastException is expected.
        LongConversions.toLocalTime(notALong, dummyConverter);
    }

    // -----------------------------------------------------------------------
    // 4. Null handling tests
    // -----------------------------------------------------------------------

    /**
     * Passing {@code null} as the source object results in a {@link NullPointerException}
     * because the method attempts to cast it to {@code Long}. This test documents that
     * behaviour.
     */
    @Test(expected = NullPointerException.class)
    public void testToLocalTime_NullSource() {
        LongConversions.toLocalTime(null, dummyConverter);
    }

    /**
     * The {@code Converter} argument is not used, but passing {@code null}
     * should still allow the method to succeed for a valid millisecond value.
     */
    @Test
    public void testToLocalTime_NullConverter() {
        long millis = 1_000L; // 1 second
        LocalTime expected = LocalTime.ofSecondOfDay(1);
        LocalTime actual = LongConversions.toLocalTime(millis, null);
        assertEquals("Conversion should succeed even when converter is null", expected, actual);
    }
}
