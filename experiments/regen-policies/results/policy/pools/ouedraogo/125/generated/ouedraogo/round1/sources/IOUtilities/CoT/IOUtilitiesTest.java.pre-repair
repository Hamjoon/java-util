package com.cedarsoftware.util;

import org.junit.After;
import org.junit.Before;
import org.junit.Test;

import javax.xml.stream.XMLStreamException;
import javax.xml.stream.XMLStreamReader;
import javax.xml.stream.XMLStreamWriter;
import java.io.*;
import java.net.URLConnection;
import java.nio.file.Files;
import java.util.Arrays;
import java.util.zip.GZIPInputStream;
import java.util.zip.GZIPOutputStream;

import static org.junit.Assert.*;

/**
 * JUnit‑4 test suite for {@link IOUtilities}.
 *
 * The test suite is organised as follows:
 *
 * 1.  List of all public methods (including signatures) extracted from {@code IOUtilities}.
 * 2.  Basic functional tests for each public method.
 * 3.  Edge‑case / exception tests identified from the source code.
 * 4.  Helper classes used by the tests (a simple {@link TestURLConnection},
 *     a {@link ThrowingCloseable}, a {@link ThrowingFlushable},
 *     and minimal XMLStreamReader/Writer implementations that throw
 *     {@link XMLStreamException} on {@code close()}).
 *
 * No external mocking libraries are used – every object is constructed from
 * the public API that exists in the supplied source code.
 */
public class IOUtilitiesTest {

    /* -------------------------------------------------------------
     * 1. PUBLIC METHOD SIGNATURES (extracted from IOUtilities)
     * ------------------------------------------------------------- */
