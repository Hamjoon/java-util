    // Callback interface (nested)
    // public interface TransferCallback { void bytesTransferred(byte[] bytes, int count); boolean isCancelled(); }

    /* -------------------------------------------------------------
     * 2. TEST FIXTURE SET‑UP
     * ------------------------------------------------------------- */
    private File tempFile;
    private final byte[] sampleData = "The quick brown fox jumps over the lazy dog".getBytes();

    @Before
    public void setUp() throws IOException {
        tempFile = File.createTempFile("ioUtilTest", ".tmp");
        Files.write(tempFile.toPath(), sampleData);
    }

    @After
    public void tearDown() {
        if (tempFile != null && tempFile.exists()) {
            tempFile.delete();
        }
    }

    /* -------------------------------------------------------------
     * 3. BASIC FUNCTIONAL TESTS
     * ------------------------------------------------------------- */

    @Test
    public void testGetInputStream_NoEncoding() throws Exception {
        TestURLConnection conn = new TestURLConnection(sampleData);
        conn.setContentEncoding(null);
        InputStream is = IOUtilities.getInputStream(conn);
        byte[] read = readAll(is);
        assertArrayEquals(sampleData, read);
    }

    @Test
    public void testGetInputStream_GzipEncoding() throws Exception {
        byte[] gzipped = gzip(sampleData);
        TestURLConnection conn = new TestURLConnection(gzipped);
        conn.setContentEncoding("gzip");
        InputStream is = IOUtilities.getInputStream(conn);
        byte[] read = readAll(is);
        assertArrayEquals(sampleData, read);
    }

    @Test
    public void testGetInputStream_DeflateEncoding() throws Exception {
        byte[] deflated = deflate(sampleData);
        TestURLConnection conn = new TestURLConnection(deflated);
        conn.setContentEncoding("deflate");
        InputStream is = IOUtilities.getInputStream(conn);
        byte[] read = readAll(is);
        assertArrayEquals(sampleData, read);
    }

    @Test
    public void testTransfer_InputStream_To_OutputStream() throws Exception {
        ByteArrayInputStream in = new ByteArrayInputStream(sampleData);
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        IOUtilities.transfer(in, out);
        assertArrayEquals(sampleData, out.toByteArray());
    }

    @Test
    public void testTransfer_InputStream_To_OutputStream_WithCallback() throws Exception {
        ByteArrayInputStream in = new ByteArrayInputStream(sampleData);
        ByteArrayOutputStream out = new ByteArrayOutputStream();

        final int[] transferred = {0};
        IOUtilities.TransferCallback cb = new IOUtilities.TransferCallback() {
            @Override public void bytesTransferred(byte[] bytes, int count) { transferred[0] += count; }
            @Override public boolean isCancelled() { return false; }
        };

        IOUtilities.transfer(in, out, cb);
        assertArrayEquals(sampleData, out.toByteArray());
        assertEquals(sampleData.length, transferred[0]);
    }

    @Test
    public void testTransfer_InputStream_To_OutputStream_WithCancellation() throws Exception {
        // The callback will cancel after the first buffer write.
        ByteArrayInputStream in = new ByteArrayInputStream(sampleData);
        ByteArrayOutputStream out = new ByteArrayOutputStream();

        IOUtilities.TransferCallback cb = new IOUtilities.TransferCallback() {
            private boolean cancelled = false;
            @Override public void bytesTransferred(byte[] bytes, int count) { cancelled = true; }
            @Override public boolean isCancelled() { return cancelled; }
        };

        IOUtilities.transfer(in, out, cb);
        // Because cancellation occurs after first buffer, we expect at most TRANSFER_BUFFER bytes.
        assertTrue(out.size() <= IOUtilities.TRANSFER_BUFFER);
    }

    @Test
    public void testTransfer_InputStream_To_ByteArrayExact() throws Exception {
        byte[] target = new byte[sampleData.length];
        ByteArrayInputStream in = new ByteArrayInputStream(sampleData);
        IOUtilities.transfer(in, target);
        assertArrayEquals(sampleData, target);
    }

    @Test(expected = IOException.class)
    public void testTransfer_InputStream_To_ByteArrayTooShort() throws Exception {
        byte[] target = new byte[sampleData.length - 5];
        ByteArrayInputStream in = new ByteArrayInputStream(sampleData);
        IOUtilities.transfer(in, target); // should throw IOException
    }

    @Test
    public void testTransfer_File_To_OutputStream() throws Exception {
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        IOUtilities.transfer(tempFile, out);
        assertArrayEquals(sampleData, out.toByteArray());
    }

    @Test
    public void testTransfer_File_To_URLConnection() throws Exception {
        TestURLConnection conn = new TestURLConnection();
        IOUtilities.transfer(tempFile, conn, null);
        assertArrayEquals(sampleData, conn.getWrittenBytes());
    }

    @Test
    public void testTransfer_URLConnection_To_File() throws Exception {
        TestURLConnection conn = new TestURLConnection(sampleData);
        File dest = File.createTempFile("ioUtilDest", ".tmp");
        try {
            IOUtilities.transfer(conn, dest, null);
            byte[] read = Files.readAllBytes(dest.toPath());
            assertArrayEquals(sampleData, read);
        } finally {
            dest.delete();
        }
    }

    @Test
    public void testInputStreamToBytes_Normal() throws Exception {
        ByteArrayInputStream in = new ByteArrayInputStream(sampleData);
        byte[] result = IOUtilities.inputStreamToBytes(in);
        assertArrayEquals(sampleData, result);
    }

    @Test
    public void testInputStreamToBytes_WithExceptionReturnsNull() throws Exception {
        InputStream throwing = new InputStream() {
            @Override public int read() throws IOException { throw new IOException("boom"); }
        };
        assertNull(IOUtilities.inputStreamToBytes(throwing));
    }

    @Test
    public void testTransfer_URLConnection_WithBytes() throws Exception {
        TestURLConnection conn = new TestURLConnection();
        IOUtilities.transfer(conn, sampleData);
        assertArrayEquals(sampleData, conn.getWrittenBytes());
    }

    @Test
    public void testCompressBytes_ByteArray() {
        byte[] compressed = IOUtilities.compressBytes(sampleData);
        assertNotNull(compressed);
        assertTrue(compressed.length < sampleData.length); // usually smaller
        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals(sampleData, uncompressed);
    }

    @Test
    public void testCompressBytes_ByteArray_Empty() {
        byte[] empty = new byte[0];
        byte[] compressed = IOUtilities.compressBytes(empty);
        assertNotNull(compressed);
        // Decompressing an empty array should give back an empty array
        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals(empty, uncompressed);
    }

    @Test
    public void testCompressBytes_ByteArray_WithOffsetLen() {
        byte[] data = "ABCDEFGHIJ".getBytes();
        byte[] compressed = IOUtilities.compressBytes(data, 2, 5); // "CDEFG"
        byte[] uncompressed = IOUtilities.uncompressBytes(compressed);
        assertArrayEquals("CDEFG".getBytes(), uncompressed);
    }

    @Test
    public void testCompressBytes_ByteArrayOutputStream() throws Exception {
        ByteArrayOutputStream original = new ByteArrayOutputStream();
        original.write(sampleData);
        ByteArrayOutputStream compressed = new ByteArrayOutputStream();
        IOUtilities.compressBytes(original, compressed);
        byte[] result = IOUtilities.uncompressBytes(compressed.toByteArray());
        assertArrayEquals(sampleData, result);
    }

    @Test
    public void testCompressBytes_FastByteArrayOutputStream() throws Exception {
        FastByteArrayOutputStream original = new FastByteArrayOutputStream();
        original.write(sampleData);
        FastByteArrayOutputStream compressed = new FastByteArrayOutputStream();
        IOUtilities.compressBytes(original, compressed);
        byte[] result = IOUtilities.uncompressBytes(compressed.toByteArray());
        assertArrayEquals(sampleData, result);
    }

    @Test
    public void testUncompressBytes_NotGzippedReturnsOriginal() {
        byte[] notGz = "plain text".getBytes();
        assertSame(notGz, IOUtilities.uncompressBytes(notGz));
    }

    @Test
    public void testClose_Closeable_NoException() {
        Closeable c = new ByteArrayOutputStream(); // close() never throws
        IOUtilities.close(c); // should not throw
    }

    @Test
    public void testClose_Closeable_WithException() {
        Closeable throwing = new ThrowingCloseable();
        // exception is suppressed – test passes if no exception propagates
        IOUtilities.close(throwing);
    }

    @Test
    public void testClose_Closeable_Null() {
        IOUtilities.close((Closeable) null); // should be a no‑op
    }

    @Test
    public void testFlush_Flushable_NoException() {
        Flushable f = new Flushable() {
            @Override public void flush() { /* no‑op */ }
        };
        IOUtilities.flush(f);
    }

    @Test
    public void testFlush_Flushable_WithException() {
        Flushable throwing = new ThrowingFlushable();
        // exception suppressed
        IOUtilities.flush(throwing);
    }

    @Test
    public void testFlush_Flushable_Null() {
        IOUtilities.flush((Flushable) null);
    }

    @Test
    public void testClose_XMLStreamReader_NoException() {
        XMLStreamReader reader = new DummyXMLStreamReader();
        IOUtilities.close(reader);
    }

    @Test
    public void testClose_XMLStreamReader_WithException() {
        XMLStreamReader throwing = new ThrowingXMLStreamReader();
        IOUtilities.close(throwing); // exception suppressed
    }

    @Test
    public void testClose_XMLStreamWriter_NoException() {
        XMLStreamWriter writer = new DummyXMLStreamWriter();
        IOUtilities.close(writer);
    }

    @Test
    public void testClose_XMLStreamWriter_WithException() {
        XMLStreamWriter throwing = new ThrowingXMLStreamWriter();
        IOUtilities.close(throwing); // exception suppressed
    }

    @Test
    public void testFlush_XMLStreamWriter_NoException() {
        XMLStreamWriter writer = new DummyXMLStreamWriter();
        IOUtilities.flush(writer);
    }

    @Test
    public void testFlush_XMLStreamWriter_WithException() {
        XMLStreamWriter throwing = new ThrowingXMLStreamWriter();
        IOUtilities.flush(throwing); // exception suppressed
    }

    /* -------------------------------------------------------------
     * 4. EDGE‑CASE / EXCEPTION TESTS
     * ------------------------------------------------------------- */

    @Test(expected = IOException.class)
    public void testGetInputStream_IOExceptionFromURLConnection() throws Exception {
        TestURLConnection conn = new TestURLConnection() {
            @Override public InputStream getInputStream() throws IOException {
                throw new IOException("forced");
            }
        };
        IOUtilities.getInputStream(conn);
    }

    @Test(expected = RuntimeException.class)
    public void testCompressBytes_ByteArray_RuntimeExceptionOnFailure() {
        // Force a failure by passing a null array – the method will throw NPE which is wrapped.
        IOUtilities.compressBytes(null);
    }

    @Test(expected = RuntimeException.class)
    public void testUncompressBytes_RuntimeExceptionOnBadGzip() {
        // Create a byte array that looks like gzipped data but is corrupted.
        byte[] bad = new byte[] { (byte)0x1f, (byte)0x8b, 0, 0, 0, 0, 0, 0, 0, 0 };
        IOUtilities.uncompressBytes(bad);
    }

    /* -------------------------------------------------------------
     * 5. HELPER METHODS & CLASSES
     * ------------------------------------------------------------- */

    /** Reads all bytes from the given InputStream (does not close the stream). */
    private static byte[] readAll(InputStream is) throws IOException {
        ByteArrayOutputStream baos = new ByteArrayOutputStream();
        IOUtilities.transfer(is, baos);
        return baos.toByteArray();
    }

    /** Returns a GZIP‑compressed copy of the supplied data. */
    private static byte[] gzip(byte[] data) throws IOException {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        try (GZIPOutputStream gos = new GZIPOutputStream(bos)) {
            gos.write(data);
        }
        return bos.toByteArray();
    }

    /** Returns a DEFLATE‑compressed copy of the supplied data (no GZIP header). */
    private static byte[] deflate(byte[] data) throws IOException {
        ByteArrayOutputStream bos = new ByteArrayOutputStream();
        try (DeflaterOutputStream dos = new DeflaterOutputStream(bos)) {
            dos.write(data);
        }
        return bos.toByteArray();
    }

    /** Simple URLConnection implementation that works with in‑memory byte arrays. */
    private static class TestURLConnection extends URLConnection {
        private ByteArrayInputStream input;
        private ByteArrayOutputStream output = new ByteArrayOutputStream();
        private String contentEncoding;

        /** For connections that only provide an output stream (e.g., upload). */
        TestURLConnection() {
            super(null);
        }

        /** For connections that provide an input stream (e.g., download). */
        TestURLConnection(byte[] data) {
            super(null);
            this.input = new ByteArrayInputStream(data);
        }

        @Override public void connect() { /* no real connection needed */ }

        @Override public InputStream getInputStream() {
            return input != null ? input : new ByteArrayInputStream(new byte[0]);
        }

        @Override public OutputStream getOutputStream() {
            return output;
        }

        public byte[] getWrittenBytes() {
            return output.toByteArray();
        }

        public void setContentEncoding(String enc) {
            this.contentEncoding = enc;
        }

        @Override public String getContentEncoding() {
            return contentEncoding;
        }
    }

    /** Closeable that always throws IOException on close(). */
    private static class ThrowingCloseable implements Closeable {
        @Override public void close() throws IOException {
            throw new IOException("forced close failure");
        }
    }

    /** Flushable that always throws IOException on flush(). */
    private static class ThrowingFlushable implements Flushable {
        @Override public void flush() throws IOException {
            throw new IOException("forced flush failure");
        }
    }

    /** Minimal XMLStreamReader that does nothing on close(). */
